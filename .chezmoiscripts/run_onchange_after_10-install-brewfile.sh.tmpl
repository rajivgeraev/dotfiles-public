#!/bin/bash
# Ставит пакеты из Brewfile.
#
# Homebrew здесь НЕ устанавливается — он предусловие, наравне с Xcode CLT,
# и ставится вручную до chezmoi (см. README, шаг 2). Причина: его установщик
# требует sudo, а скрипт, который сам просит пароль администратора, — плохой
# паттерн: пользователь не видит, что именно потребует привилегий. Пусть
# официальный установщик Homebrew спросит пароль сам, в вашем терминале.
#
# after_, а не before_: конфиги должны лечь на диск ДО установки пакетов.
# Раньше этот скрипт был before_ под `set -e`, и один сбойный каск обрывал
# весь `chezmoi apply`, оставляя машину вообще без dotfiles. Порядок «сначала
# конфиги, потом пакеты» безопасен, потому что conf.d/*.zsh гейтят каждый
# инструмент через `command -v` в момент запуска шелла, а не при apply.
#
# Числовой префикс 10- задаёт порядок явно: 10 → 20 → 30. Полагаться на
# алфавитную сортировку имён здесь уже обжигались.
#
# run_onchange_ по хешу Brewfile: добавили пакет — скрипт отработает снова.
# Brewfile: {{ include "Brewfile" | sha256sum }}

set -uo pipefail

if ! command -v brew >/dev/null 2>&1; then
  for brew_prefix in /opt/homebrew /usr/local; do
    if [ -x "$brew_prefix/bin/brew" ]; then
      eval "$("$brew_prefix/bin/brew" shellenv)"
      break
    fi
  done
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "!! Homebrew не найден. Это предусловие, а не задача chezmoi." >&2
  echo "!! Установите его и повторите: chezmoi apply" >&2
  echo "!!   /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"" >&2
  exit 1
fi

echo "==> Установка пакетов из Brewfile. Это самая долгая часть."
echo "==> Каск karabiner-elements ставится через .pkg и спросит пароль администратора."
echo "==> Остальные восемь касков — обычные .app, привилегий не требуют."

if brew bundle --verbose --file="{{ .chezmoi.sourceDir }}/Brewfile"; then
  echo "==> Brewfile: всё установлено."
  exit 0
fi

# Сюда попадаем, если хотя бы один пакет не поставился. Намеренно выходим с 0:
# остальные скрипты (кеш bat, настройки macOS) должны отработать, а недостающий
# инструмент просто не включится — ровно так и задумано в conf.d.
cat >&2 <<'WARN'

!! ============================================================
!! Brewfile отработал НЕ полностью — часть пакетов не встала.
!! Обычная причина: сбой сети при скачивании каска.
!!
!! Остальной restore продолжается: конфиги уже на диске, а всё,
!! что не установилось, просто не включится в шелле.
!!
!! Повторить установку недостающего:
!!     brew bundle --verbose --file=~/.local/share/chezmoi/Brewfile
!!
!! Посмотреть, чего не хватает:
!!     brew bundle check --verbose --file=~/.local/share/chezmoi/Brewfile
!! ============================================================

WARN
exit 0
