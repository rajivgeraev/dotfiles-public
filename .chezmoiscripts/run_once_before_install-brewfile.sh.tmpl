#!/bin/bash
set -e

if ! command -v brew >/dev/null 2>&1; then
  echo "==> Homebrew не найден, устанавливаю…"

  # Установщик Homebrew создаёт /opt/homebrew через sudo, а NONINTERACTIVE=1 запрещает
  # ему спрашивать пароль — иначе установка не была бы неинтерактивной. На чистой
  # системе кэш sudo пуст, и получается тупик: пароль нужен, а спросить нельзя.
  # Поэтому аутентифицируемся заранее, здесь и явно.
  echo "==> Для установки Homebrew нужны права администратора."
  sudo -v || { echo "!! Без sudo установить Homebrew нельзя." >&2; exit 1; }

  # Кэш sudo живёт ~5 минут, а brew bundle тянет десяток GUI-приложений и идёт куда
  # дольше. Продлеваем сессию, пока жив этот скрипт: заодно это покрывает casks
  # с pkg-инсталляторами, которые тоже просят sudo.
  while true; do sudo -n true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done 2>/dev/null &
  sudo_keepalive=$!
  trap 'kill "$sudo_keepalive" 2>/dev/null || true' EXIT

  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  echo "==> Homebrew: установка завершена."
fi

# Префикс зависит от архитектуры: /opt/homebrew на Apple Silicon, /usr/local на Intel.
# Свежеустановленный brew ещё не в PATH этого процесса, поэтому подцепляем его явно.
if ! command -v brew >/dev/null 2>&1; then
  for brew_prefix in /opt/homebrew /usr/local; do
    if [ -x "$brew_prefix/bin/brew" ]; then
      eval "$("$brew_prefix/bin/brew" shellenv)"
      break
    fi
  done
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "!! brew не найден ни в /opt/homebrew, ни в /usr/local — прерываю." >&2
  exit 1
fi

echo "==> Установка пакетов и приложений из Brewfile (может занять продолжительное время, особенно в VM)…"
brew bundle --verbose --file="{{ .chezmoi.sourceDir }}/Brewfile"
echo "==> Brewfile: установка завершена."
